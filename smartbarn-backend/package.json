{
  "name": "smartbarn-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:k6": ".\\k6-mqtt.exe run k6-load-test.js",
    "test:k6:10vu": ".\\k6-mqtt.exe run --vus 10 --duration 30s k6-load-test.js",
    "test:k6:50vu": ".\\k6-mqtt.exe run --vus 50 --duration 30s k6-load-test.js",
    "test:k6:100vu": ".\\k6-mqtt.exe run --vus 100 --duration 30s k6-load-test.js",
    "test:k6:sensor:10vu": ".\\k6-mqtt.exe run --vus 10 --duration 30s k6-sensor-test.js",
    "test:k6:sensor:50vu": ".\\k6-mqtt.exe run --vus 50 --duration 30s k6-sensor-test.js",
    "test:k6:sensor:100vu": ".\\k6-mqtt.exe run --vus 100 --duration 30s k6-sensor-test.js",
    "test:k6:env:10vu": ".\\k6-mqtt.exe run --vus 10 --duration 30s k6-env-test.js",
    "test:k6:env:50vu": ".\\k6-mqtt.exe run --vus 50 --duration 30s k6-env-test.js",
    "test:k6:env:100vu": ".\\k6-mqtt.exe run --vus 100 --duration 30s k6-env-test.js",
    "test:k6:ws:10vu": ".\\k6-mqtt.exe run --vus 10 --duration 30s k6-ws-realtime-test.js",
    "test:k6:ws:50vu": ".\\k6-mqtt.exe run --vus 50 --duration 30s k6-ws-realtime-test.js",
    "test:k6:ws:100vu": ".\\k6-mqtt.exe run --vus 100 --duration 30s k6-ws-realtime-test.js",
    "test:k6:web:10vu": "k6 run --vus 10 --duration 30s k6-web-test.js",
    "test:k6:web:50vu": "k6 run --vus 50 --duration 30s k6-web-test.js",
    "test:k6:web:100vu": "k6 run --vus 100 --duration 30s k6-web-test.js",
    "test:local:load:10vu": "k6 run -e LOCAL=true --vus 10 --duration 30s k6-load-test.js",
    "test:local:load:50vu": "k6 run -e LOCAL=true --vus 50 --duration 30s k6-load-test.js",
    "test:local:load:100vu": "k6 run -e LOCAL=true --vus 100 --duration 30s k6-load-test.js",
    "test:local:sensor:10vu": "k6 run -e LOCAL=true --vus 10 --duration 30s k6-sensor-test.js",
    "test:local:sensor:50vu": "k6 run -e LOCAL=true --vus 50 --duration 30s k6-sensor-test.js",
    "test:local:sensor:100vu": "k6 run -e LOCAL=true --vus 100 --duration 30s k6-sensor-test.js",
    "test:local:env:10vu": "k6 run -e LOCAL=true --vus 10 --duration 30s k6-env-test.js",
    "test:local:env:50vu": "k6 run -e LOCAL=true --vus 50 --duration 30s k6-env-test.js",
    "test:local:env:100vu": "k6 run -e LOCAL=true --vus 100 --duration 30s k6-env-test.js",
    "test:local:ws:10vu": "k6 run -e LOCAL=true --vus 10 --duration 30s k6-ws-realtime-test.js",
    "test:local:ws:50vu": "k6 run -e LOCAL=true --vus 50 --duration 30s k6-ws-realtime-test.js",
    "test:local:ws:100vu": "k6 run -e LOCAL=true --vus 100 --duration 30s k6-ws-realtime-test.js",
    "test:local:web:10vu": "k6 run -e LOCAL=true --vus 10 --duration 30s k6-web-test.js",
    "test:local:web:50vu": "k6 run -e LOCAL=true --vus 50 --duration 30s k6-web-test.js",
    "test:local:web:100vu": "k6 run -e LOCAL=true --vus 100 --duration 30s k6-web-test.js",
    "test:cache:10vu": "k6 run --vus 10 --duration 30s k6-cache-benchmark.js",
    "test:cache:50vu": "k6 run --vus 50 --duration 30s k6-cache-benchmark.js",
    "test:cache:100vu": "k6 run --vus 100 --duration 30s k6-cache-benchmark.js",
    "test:local:cache:10vu": "k6 run -e LOCAL=true --vus 10 --duration 30s k6-cache-benchmark.js",
    "test:local:cache:50vu": "k6 run -e LOCAL=true --vus 50 --duration 30s k6-cache-benchmark.js",
    "test:local:cache:100vu": "k6 run -e LOCAL=true --vus 100 --duration 30s k6-cache-benchmark.js",
    "clean-db": "node clean_database_remote.js",
    "monitor": "node monitor.js"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "*",
    "@nestjs/microservices": "^11.1.19",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.19",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/websockets": "^11.1.19",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.69.1",
    "cache-manager": "^7.2.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "compression": "^1.8.1",
    "exceljs": "^4.4.0",
    "ioredis": "^5.9.3",
    "mqtt": "^5.15.1",
    "nodemailer": "^9.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@apideck/portman": "^1.35.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "newman": "^6.2.2",
    "prettier": "^3.4.2",
    "prisma": "^5.22.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
