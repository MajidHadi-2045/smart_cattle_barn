  "info": {
    "title": "Smart Cattle Barn API",
    "description": "The Smart Cattle Barn API description",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Email atau Username pengguna",
            "example": "superadmin@barn.com"
          },
          "username": {
            "type": "string",
            "description": "Username pengguna",
            "example": "superadmin"
          },
          "password": {
            "type": "string",
            "description": "Password akun",
            "example": "password123"
          },
          "role": {
            "enum": [
              "SUPER_ADMIN",
              "MANAGER",
              "STAFF",
              "VETERINER"
            ],
            "type": "string",
            "description": "Peran yang digunakan untuk login",
            "example": "SUPER_ADMIN"
          },
          "pushToken": {
            "type": "string",
            "description": "Token Push Notification Firebase/Expo"
          }
        },
        "required": [
          "password",
          "role"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "username": {
            "type": "string",
            "example": "john.doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john@barn.com"
          },
          "phone": {
            "type": "string",
            "example": "08123456789"
          },
          "password": {
            "type": "string",
            "example": "password123"
          },
          "role": {
            "enum": [
              "SUPER_ADMIN",
              "MANAGER",
              "STAFF",
              "VETERINER"
            ],
            "type": "string",
            "example": "STAFF"
          }
        },
        "required": [
          "name",
          "username",
          "email",
          "phone",
          "password",
          "role"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "pegawai@barn.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "example": "token_dari_email_disini"
          },
          "newPassword": {
            "type": "string",
            "example": "PasswordBaru123!"
          }
        },
        "required": [
          "token",
          "newPassword"
        ]
      },
      "CreateLivestockDto": {
        "type": "object",
        "properties": {
          "cattleId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "breed": {
            "type": "string"
          },
          "gender": {
            "type": "string"
          },
          "initialWeight": {
            "type": "number"
          },
          "sectionId": {
            "type": "number"
          },
          "birthDate": {
            "type": "object"
          }
        },
        "required": [
          "cattleId",
          "name",
          "breed",
          "gender",
          "initialWeight",
          "sectionId"
        ]
      }
    }
  }
}